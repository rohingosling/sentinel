# Open WebUI environment template (architecture 4.2).
#
# Sentinel injects these variables into the managed `open-webui serve` subprocess. The
# file is the authoritative list: `sentinel.core.webui` reads it, expands the four
# placeholders below from live configuration, and passes the result as the child's
# environment. Editing a value here changes the shipped behaviour; adding a line adds a
# variable.
#
# Placeholders, expanded at launch. Nothing else is substituted.
#
#   ${SENTINEL_API_URL}      The agent gateway's base URL, e.g. http://127.0.0.1:8000/v1
#   ${SENTINEL_API_TOKEN}    The bearer token, read from the OS keyring at launch.
#   ${SENTINEL_WEBUI_DATA}   ${SENTINEL_DATA}\webui
#   ${SENTINEL_NAME}         The agent's display name from agent.yaml.
#   ${SENTINEL_AVATAR}       Sentinel's mark, as a base64 PNG data URI.
#
# The token is a placeholder and never a literal. A credential written here would be
# published with the rest of config/ and would sit in plain text on every install.

# Branding. Open WebUI appends its own name to any custom value, so the interface reports
# "Sentinel (Open WebUI)". That is expected, and the attribution is accepted permanently
# (architecture Decision 5) -- the chat surface is their work and Sentinel credits it.
#
# Do not try to remove the suffix. It is applied in open_webui/env.py, so no value here can
# avoid it, and the ways around it -- patching their frontend, or monkey-patching the module
# from Sentinel's launcher -- are both refused by decision rather than blocked by difficulty.

WEBUI_NAME=${SENTINEL_NAME}

# Single-user desktop agent: no login screen, no signup, no admin chrome.

WEBUI_AUTH=false
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=false
SHOW_ADMIN_DETAILS=false

# The agent is the only model. Sentinel's gateway is OpenAI-compatible, so Open WebUI
# discovers it with no further configuration.

OPENAI_API_BASE_URL=${SENTINEL_API_URL}
OPENAI_API_KEY=${SENTINEL_API_TOKEN}
ENABLE_OPENAI_API=true
DEFAULT_MODELS=sentinel

# The icon shown beside the agent's replies and in the model picker. Without it, Open WebUI
# has no avatar for an OpenAI-compatible model and falls back to its own logo -- which then
# stands in for Sentinel, in the one place the interface is naming Sentinel rather than
# itself. This is model metadata, not Open WebUI branding: it changes what represents *our*
# model inside their app, and leaves their logo, favicon, and splash untouched.
#
# Seeded into Open WebUI's database on FIRST RUN ONLY -- existing values win over defaults
# (models/config.py: seed_defaults). Changing this on an install that has already started
# once has no effect; delete ${SENTINEL_DATA}\webui, or set the image per model under
# Workspace -> Models.
#
# The value must stay valid JSON after substitution. Base64 contains no quote or backslash,
# so it cannot break the document.

DEFAULT_MODEL_METADATA={"profile_image_url":"${SENTINEL_AVATAR}"}

# Ollama is Sentinel's fallback, reached through the agent rather than by the interface.
# Left on, Open WebUI probes localhost:11434 on every model list and stalls when nothing
# answers.

ENABLE_OLLAMA_API=false

# Co-locate Open WebUI's own SQLite database inside Sentinel's data tree, so one
# directory holds every piece of user state and one backup captures all of it.

DATA_DIR=${SENTINEL_WEBUI_DATA}

# Nothing leaves the machine that does not have to. Open WebUI's telemetry and update
# check are both off by default here rather than relying on their upstream defaults.

SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
